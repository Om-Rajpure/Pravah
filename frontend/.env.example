# PRAVAAH Frontend — Environment Configuration Template
# Copy to .env.local for local overrides.
# ⚠️ Never commit real secrets or API keys.

# Backend API base URL (defaults to /api which is proxied in vite.config.js during development)
# For production deployments with separate backend origin (e.g. Render):
# VITE_API_BASE_URL=https://pravah-zocg.onrender.com/api
VITE_API_BASE_URL=/api

# Map style JSON endpoint (defaults to OpenFreeMap Positron)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Demo mode toggle (true = Demo controls active)
VITE_DEMO_MODE=true
