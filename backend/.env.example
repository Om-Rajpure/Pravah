# PRAVAAH Backend — Environment Configuration Template
# Copy to .env and adjust values before running.
# ⚠️ Never commit real secrets or API keys.

# Flask / Web Server (Render automatically injects PORT)
PORT=5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# CORS — allowed frontend origins (comma-separated)
# Include local dev origins and your production Vercel frontend URL:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://pravah-git-main-omrajpure3-8253s-projects.vercel.app

# DuckDB — leave as :memory: for development (recommended)
# To persist data between restarts, set a file path: e.g. ./data/pravaah.duckdb
PRAVAAH_DB_PATH=:memory:

# Demo Mode (true = demo controls active, false = normal run)
PRAVAAH_DEMO_MODE=true
