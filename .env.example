# PRAVAAH — Global Environment Configuration Template
# Copy to .env and adjust values before running.
# ⚠️ Never commit real secrets or API keys.

# Environment: development | demo | production
PRAVAAH_ENV=development

# Flask Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# CORS Origins (comma-separated list of allowed web frontend domains)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Central Deterministic Simulation Seed (Ganesh Chaturthi 2026)
DEMO_SEED=20260908

# DuckDB Database Path (:memory: for high-performance zero-lock concurrency)
PRAVAAH_DB_PATH=:memory:

# Demo Mode Enabled
PRAVAAH_DEMO_MODE=true

# Map Tile Style
MAP_TILE_URL=https://tiles.openfreemap.org/styles/positron

# Frontend Environment Variables (used by Vite during build/dev)
VITE_API_BASE_URL=/api
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_DEMO_MODE=true
